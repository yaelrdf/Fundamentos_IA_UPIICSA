flowchart TD
    %% ÁRBOL DE RAMIFICACIÓN Y RESOLUCIÓN SLD
    subgraph SLDTree ["Árbol de Ramificación y Búsqueda (Inferencia Prolog & Backtracking)"]
        direction TB
        Root["<b>Meta Inicial:</b><br/>?- manzana(X)."] --> Regla["<b>Unificación con Regla:</b><br/>manzana(X) :- fruta(X), forma(X, redonda), color(X, verde).<br/><b>Metas pendientes:</b><br/>?- fruta(X), forma(X, redonda), color(X, verde)."]
        
        Regla --> Choice{"<b>Punto de Ramificación (Elección)</b><br/>Buscar hechos para: fruta(X)"}

        %% Rama 1: ciruela_victoria
        Choice -->|"Rama 1: {X = ciruela_victoria}<br/>Hecho: fruta(ciruela_victoria)"| B1["<b>Rama 1: ciruela_victoria</b><br/>?- forma(ciruela_victoria, redonda), color(ciruela_victoria, verde)."]
        B1 --> B1_Forma{"Evaluar:<br/>forma(ciruela_victoria, redonda)"}
        B1_Forma -->|"ÉXITO (Exit)<br/>Existe hecho en BD"| B1_Color{"Evaluar:<br/>color(ciruela_victoria, verde)"}
        B1_Color -->|"FALLO (Fail)<br/>BD: color(ciruela_victoria, morado)<br/>morado != verde"| B1_Fail["<b>FALLO en color/2</b>"]

        %% Backtracking
        B1_Fail ==>|"<b>BACKTRACKING (Redo)</b><br/>Retroceso al punto de elección"| Choice

        %% Rama 2: manzana_triunfo
        Choice -->|"Rama 2: {X = manzana_triunfo}<br/>Hecho: fruta(manzana_triunfo)"| B2["<b>Rama 2: manzana_triunfo</b><br/>?- forma(manzana_triunfo, redonda), color(manzana_triunfo, verde)."]
        B2 --> B2_Forma{"Evaluar:<br/>forma(manzana_triunfo, redonda)"}
        B2_Forma -->|"ÉXITO (Exit)<br/>Existe hecho en BD"| B2_Color{"Evaluar:<br/>color(manzana_triunfo, verde)"}
        
        %% Caso literal vs corregido
        B2_Color -->|"FALLO (Fail) [Código literal]<br/>BD: color(manzana_triunfo, verder)<br/>verder != verde"| B2_Fail["<b>FALLO en color/2</b><br/>Discrepancia de átomo"]
        B2_Color -.->|"ÉXITO (Exit) [Caso corregido]<br/>Si hecho fuera: color(..., verde)"| B2_Success["<b>ÉXITO DE CONSULTA</b><br/>Solución: {X = manzana_triunfo}"]

        B2_Fail --> EndFail["<b>ÁRBOL AGOTADO</b><br/>No hay más cláusulas de fruta(X)<br/>Resultado: false."]
    end

    style SLDTree fill:none

    classDef rootNode fill:none,stroke:#1565C0,stroke-width:2px;
    classDef ruleNode fill:none,stroke:#5E35B1,stroke-width:2px;
    classDef choiceNode fill:none,stroke:#FBC02D,stroke-width:2px;
    classDef branch fill:none,stroke:#00838F,stroke-width:2px;
    classDef eval fill:none,stroke:#EF6C00,stroke-width:2px;
    classDef failNode fill:none,stroke:#C62828,stroke-width:2px;
    classDef successNode fill:none,stroke:#2E7D32,stroke-width:2px;

    class Root rootNode;
    class Regla ruleNode;
    class Choice choiceNode;
    class B1,B2 branch;
    class B1_Forma,B1_Color,B2_Forma,B2_Color eval;
    class B1_Fail,B2_Fail,EndFail failNode;
    class B2_Success successNode;
