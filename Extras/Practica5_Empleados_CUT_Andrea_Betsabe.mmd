flowchart TD
    subgraph SLD_Cut_AB ["Resolución SLD con Poda de Árbol - supervisa(X, Y) [Instrucción CUT (!)]"]
        direction TB

        %% Meta Inicial
        Root["<b>Meta a Resolver:</b><br/>?- supervisa(X, Y)."]

        %% Punto de elección de reglas
        ChoiceReglas["<b>Opciones de Reglas para supervisa/2:</b><br/>(1) gerente(X), empleado(Y), !<br/>(2) empleado(X), mecanografa(Y)<br/>(3) gerente(X), mecanografa(Y)"]
        Root --> ChoiceReglas

        %% ==========================================
        %% RAMA 1: Regla 1 (con corte !)
        %% ==========================================
        ChoiceReglas -->|"1ra Opción"| R1["<b>Regla 1 Activa:</b><br/>?- gerente(X), empleado(Y), !."]
        R1 --> ChoiceR1_G["Probar hechos: gerente(X)"]

        %% R1 - Jimenez
        ChoiceR1_G -->|"X = jimenez"| R1_Jim["Éxito: gerente(jimenez)<br/>Meta pendiente: ?- empleado(Y), !."]
        R1_Jim --> ChoiceR1_Jim_E["Probar hechos: empleado(Y)"]
        ChoiceR1_Jim_E -->|"Y = ortiz"| R1_Cut["Éxito: empleado(ortiz)<br/>Submeta alcanzada: ?- !."]
        
        %% Ejecución del CUT
        R1_Cut -->|"Activación del Operador !"| S1["<b>Solución Concluida:</b><br/>{X = jimenez, Y = ortiz}"]
        
        %% Poda de alternativas dentro de la Regla 1
        ChoiceR1_Jim_E -.->|"PODA (CUT):<br/>Y = zavala"| Prune1["✂ Poda por CUT (!):<br/>Se anulan alternativas de empleado(Y)"]
        ChoiceR1_G -.->|"PODA (CUT):<br/>X = mejia"| Prune2["✂ Poda por CUT (!):<br/>Se anulan alternativas de gerente(X)"]

        %% ==========================================
        %% RAMA 2: Regla 2 (Poda)
        %% ==========================================
        ChoiceReglas -.->|"PODA (CUT)"| R2["✂ Poda de Cláusula:<br/><b>Regla 2</b> descartada sin evaluar"]

        %% ==========================================
        %% RAMA 3: Regla 3 (Poda)
        %% ==========================================
        ChoiceReglas -.->|"PODA (CUT)"| R3["✂ Poda de Cláusula:<br/><b>Regla 3</b> descartada sin evaluar"]
        
        %% Efecto del Cut
        S1 ==>|"Intento de Retroceso"| BacktrackFail["<b>PODA DEFINITIVA POR CORTE (!)</b><br/>El operador '!' congela las elecciones hechas.<br/>Impide el retroceso (backtracking) y finaliza el proceso."]
    end

    style SLD_Cut_AB fill:none

    classDef rootNode fill:none,stroke:#512DA8,stroke-width:2.5px;
    classDef choiceNode fill:none,stroke:#F57C00,stroke-width:2px;
    classDef ruleNode fill:none,stroke:#0097A7,stroke-width:2px;
    classDef branch fill:none,stroke:#37474F,stroke-width:2px;
    classDef successNode fill:none,stroke:#2E7D32,stroke-width:2.5px;
    classDef pruneNode fill:none,stroke:#D32F2F,stroke-width:2px,stroke-dasharray: 4 4,color:#B71C1C;
    classDef infoNode fill:none,stroke:#C2185B,stroke-width:2px;

    class Root rootNode;
    class ChoiceReglas,ChoiceR1_G,ChoiceR1_Jim_E choiceNode;
    class R1 ruleNode;
    class R1_Jim,R1_Cut branch;
    class S1 successNode;
    class Prune1,Prune2,R2,R3 pruneNode;
    class BacktrackFail infoNode;
